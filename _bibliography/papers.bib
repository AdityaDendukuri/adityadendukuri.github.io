@article{FORD2020106989,
title = {Machine learning to identify variables in thermodynamically small systems},
journal = {Computers \& Chemical Engineering},
volume = {141},
pages = {106989},
year = {2020},
issn = {0098-1354},
doi = {https://doi.org/10.1016/j.compchemeng.2020.106989},
url = {https://www.sciencedirect.com/science/article/pii/S0098135419311937},
author = {David M. Ford and Aditya Dendukuri and Gülce Kalyoncu and Khoa Luu and Matthew J. Patitz},
keywords = {Artificial neural networks, Diffusion maps, Molecular simulation, Clusters},
abstract = {Thermodynamically small systems, with a number N of interacting particles in the range of 1–1000, are increasingly of interest in science and engineering. While the thermodynamic formalism for bulk systems, where N approaches infinity, was established long ago, the thermodynamics of small systems is currently approached by adding new variables in a somewhat ad hoc fashion. We propose a more rigorous approach based on machine learning (ML), which we demonstrate by applying both unsupervised (diffusion maps, autoencoders) and supervised (classical neural networks) ML methods to large data sets from Monte Carlo simulations of systems comprising N=3 Lennard-Jones particles at fixed temperature. The ML methods clearly identify structural and energetic changes that occur in this model system and suggest that the data may be collapsed from the original nine dimensions to two. Using intuition and screening, we identified two simple geometric properties of the system as a useful variable set.}
}

